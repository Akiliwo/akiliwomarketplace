# Copy this file to .env (same folder) and fill it in. NEVER commit .env or share it.
# eBay PRODUCTION keys (developer.ebay.com > Application Keys > Production)

EBAY_CLIENT_ID=Akiliwom-AkiliwoS-PRD-5c897e253-5dcec868
EBAY_CERT_ID=
# Dev ID is not used by these REST APIs (only by the old Trading API); kept for reference.
EBAY_DEV_ID=1f5c1865-419e-4bb5-aef7-dcfd323a1fbb

# RuName ("eBay Redirect URL name"): developer.ebay.com > User Tokens > Get a Token from eBay
# via Your Application > add/see your Production RuName (looks like Akiliwo_M-AkiliwoS-...-abcde)
EBAY_RUNAME=

# Filled in by:  python ebay_bulk_all_products.py auth
EBAY_REFRESH_TOKEN=

# Business policy IDs - list them with:  python ebay_bulk_all_products.py policies
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=

# Where items ship from (created on eBay automatically the first time you publish)
EBAY_LOCATION_KEY=akiliwo-colorado
EBAY_LOCATION_CITY=Lakewood
EBAY_LOCATION_STATE=CO
EBAY_LOCATION_POSTAL=
EBAY_LOCATION_COUNTRY=US
